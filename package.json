{
  "name": "@markforster/cubits",
  "version": "0.2.2",
  "description": "3x3 rubiks cube module with methods to rotate sides by colour and check if solved",
  "main": "./dist/index.js",
  "scripts": {
    "build": "./bin/build.sh",
    "examples": "npm --prefix ./examples/ run example",
    "fallow": "fallow --summary",
    "fallow:audit": "fallow audit --gate all --changed-since develop",
    "fallow:dead-code": "fallow dead-code",
    "test": "jest --passWithNoTests --roots ./src --silent --coverage --coverageDirectory test-reports --watchman=false"
  },
  "author": "markforster",
  "repository": {
    "type": "git",
    "url": "https://github.com/markforster/cubits"
  },
  "bugs": {
    "url": "https://github.com/markforster/cubits/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=14.6.0"
  },
  "keywords": [
    "rubiks",
    "cube",
    "rubiks cube",
    "model"
  ],
  "devDependencies": {
    "@types/jest": "^29.5.3",
    "@types/node": "^20.9.1",
    "@types/webpack-node-externals": "^3.0.4",
    "@typescript-eslint/eslint-plugin": "^6.10.0",
    "@typescript-eslint/parser": "^6.10.0",
    "bundle-declarations-webpack-plugin": "^4.0.1",
    "eslint": "^8.53.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-prettier": "^5.0.1",
    "fallow": "^2.88.3",
    "jest": "^29.6.2",
    "jest-html-reporter": "^3.10.1",
    "jest-html-reporters": "^3.1.4",
    "jest-stare": "^2.5.0",
    "prettier": "^3.0.3",
    "ts-jest": "^29.1.1",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.6",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "webpack-node-externals": "^3.0.0"
  }
}
